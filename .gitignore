# 가상환경
.venv/
venv/

# 환경 변수 (API 키)
.env
.env.*
!.env.example

# 빌드 산출물 (AGENTS.md 금지 사항)
# docs/seed/는 직접 작성한 문서라 커밋한다. 제외 대상이 아니다.
index/

# 연습용 스크립트 (개인 실험용, 커밋하지 않음)
try_*.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Claude Code 개인 설정 (머신별 경로·권한이 들어감)
# .claude/skills/ 는 팀 공용이므로 커밋한다
.claude/settings.local.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 평가 실행 결과 (점수표는 노션·PR에 남긴다)
eval/run-*.json
