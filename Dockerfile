# AI 서버(FastAPI)를 컨테이너로 실행하기 위한 이미지 정의다.
#
# 목적은 "내 맥북에서는 되는데"를 없애는 것이다. 파이썬 버전, 설치한 라이브러리,
# 시간대 설정까지 이 파일에 적힌 대로 고정되므로 어디서 돌려도 같게 동작한다.
#
# 빌드:  docker build -t stream-ai .
# 실행:  docs/guides/docker.md 참고 (환경변수와 인증 파일을 넘겨야 한다)

# ─────────────────────────────────────────────────────────────
# 1. 기반 이미지
# ─────────────────────────────────────────────────────────────
# 맥북의 파이썬이 3.14.3이라 같은 3.14로 맞춘다. 버전이 다르면
# 로컬에서 통과한 코드가 컨테이너에서 깨질 수 있다.
#
# `-slim`은 문서·컴파일러 같은 걸 뺀 작은 판이다. 기본 이미지는 1GB에 가깝고
# slim은 그 1/8 정도다. 이미지가 작으면 올리고 내리는 시간이 줄어든다.
#
# alpine(더 작은 판)을 쓰지 않는 이유: 표준 C 라이브러리가 달라서
# cryptography, cffi처럼 C로 된 라이브러리를 직접 컴파일해야 한다.
# requirements.txt에 그것들이 들어 있어 빌드가 몇 분씩 걸리고 실패하기도 쉽다.
FROM python:3.14-slim

# ─────────────────────────────────────────────────────────────
# 2. 시간대 데이터
# ─────────────────────────────────────────────────────────────
# app.py가 `ZoneInfo("Asia/Seoul")`로 한국 시간을 구한다. 맥에는 시간대 표가
# 원래 들어 있어서 그냥 됐지만, slim 이미지에는 없어서 그대로 두면
# ZoneInfoNotFoundError가 난다. 오늘 날짜를 프롬프트에 넣는 기능이 죽는다.
#
# `--no-install-recommends`: 꼭 필요한 것만 깐다.
# `rm -rf /var/lib/apt/lists/*`: 설치 목록 캐시를 지워 이미지 크기를 줄인다.
#   한 RUN 안에서 지워야 의미가 있다. 줄을 나누면 앞 층에 캐시가 남는다.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# 3. 파이썬 실행 옵션
# ─────────────────────────────────────────────────────────────
# PYTHONUNBUFFERED: 로그를 모아두지 않고 바로 내보낸다. 이게 없으면
#   `docker logs`에 아무것도 안 보여서 서버가 죽은 줄 알게 된다.
# PYTHONDONTWRITEBYTECODE: .pyc 캐시 파일을 만들지 않는다. 컨테이너는
#   한 번 쓰고 버리므로 캐시가 쓸모없고 이미지만 커진다.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 앞으로의 명령이 실행될 기준 폴더. 없으면 만들어진다.
WORKDIR /app

# ─────────────────────────────────────────────────────────────
# 4. 라이브러리 설치 — requirements.txt만 먼저 복사한다
# ─────────────────────────────────────────────────────────────
# 소스 전체를 먼저 복사하지 않는 이유가 여기 있다.
#
# 도커는 명령 한 줄마다 "층"을 만들어 두고, 다음 빌드에서 그 줄의 입력이
# 안 바뀌었으면 층을 그대로 재사용한다. app.py를 한 글자 고쳤을 때
# 소스를 먼저 복사했다면 그 아래 있는 pip install 층까지 전부 무효가 되어
# 라이브러리를 30개 다시 깐다.
#
# requirements.txt를 따로 먼저 복사하면, 라이브러리 목록이 그대로인 한
# pip install 층이 재사용된다. 빌드가 몇 분에서 몇 초로 줄어든다.
COPY requirements.txt .

# --no-cache-dir: pip가 받아둔 설치 파일을 남기지 않는다. 이미지 안에서
#   다시 설치할 일이 없으므로 그냥 용량 낭비다.
RUN pip install --no-cache-dir -r requirements.txt

# ─────────────────────────────────────────────────────────────
# 5. 소스 복사
# ─────────────────────────────────────────────────────────────
# 무엇이 빠지는지는 .dockerignore가 정한다. .env, .venv, .git 등은 들어오지 않는다.
# 특히 .env가 이미지에 들어가면 이미지를 가진 사람이 모두 설정값을 볼 수 있다.
COPY . .

# ─────────────────────────────────────────────────────────────
# 6. 검색 인덱스 만들기
# ─────────────────────────────────────────────────────────────
# index/bm25.json은 .gitignore 대상이라 저장소에 없다. 그래서 이미지를
# 만들 때 여기서 생성한다. 재료(docs/seed/, test_data/)는 커밋돼 있어 가능하다.
#
# 실행할 때 만들지 않고 빌드할 때 만드는 이유: 컨테이너가 뜨는 즉시 답할 수 있어야 하고,
# 인덱스 만들기가 실패하면 배포 전에 빌드가 실패해서 알 수 있다.
# 실행 중에 만들면 학생 질문을 받고 나서야 문제를 알게 된다.
RUN python build_index.py

# ─────────────────────────────────────────────────────────────
# 7. 일반 사용자로 내려오기
# ─────────────────────────────────────────────────────────────
# 도커는 기본이 root다. 서버 코드에 취약점이 생겼을 때 root면 컨테이너 안에서
# 할 수 있는 일이 많아진다. 여기까지 설치가 끝났으니 권한을 내린다.
#
# --system: 로그인 못 하는 계정으로 만든다. 사람이 쓸 계정이 아니다.
RUN useradd --system --create-home appuser \
    && chown -R appuser:appuser /app
USER appuser

# ─────────────────────────────────────────────────────────────
# 8. 포트 안내
# ─────────────────────────────────────────────────────────────
# EXPOSE는 실제로 포트를 여는 명령이 아니다. "이 이미지는 8000을 쓴다"는 메모이고,
# 실제 연결은 실행할 때 `-p 8000:8000`으로 맺는다. 읽는 사람을 위한 표시다.
EXPOSE 8000

# ─────────────────────────────────────────────────────────────
# 9. 실행 명령
# ─────────────────────────────────────────────────────────────
# --host 0.0.0.0 이 중요하다. 기본값 127.0.0.1은 "나 자신에게서 온 연결만 받는다"는
# 뜻이고, 컨테이너 안에서 그러면 컨테이너 밖에서는 접속이 안 된다.
# 서버는 떴는데 브라우저가 연결을 거부하는 흔한 원인이다.
#
# ${PORT:-8000}: 배포 환경이 PORT 환경변수로 포트를 정해 넘기는 경우가 있다
# (Cloud Run은 8080을 넘긴다). 넘어오면 그것을 쓰고, 없으면 8000을 쓴다.
# 이 치환이 되게 하려면 목록 형태(["uvicorn", ...])가 아니라 아래처럼 써야 한다.
# 목록 형태는 셸을 거치지 않아 ${PORT}가 글자 그대로 전달된다.
#
# 맨 앞의 `exec`가 필요하다. 이게 없으면 셸이 1번 프로세스로 남고 uvicorn은 그
# 자식이 된다. 컨테이너를 멈출 때 도커는 1번 프로세스에게 "정리하고 끝내라"는
# 신호(SIGTERM)를 보내는데, 셸은 그 신호를 자식에게 넘겨주지 않는다.
# 그러면 uvicorn이 응답을 끊지 못한 채 10초 뒤 강제 종료된다.
# SSE는 연결을 길게 붙잡고 있으므로 답변 중이던 학생의 화면이 그냥 멈춘다.
# `exec`는 셸 자신을 uvicorn으로 바꿔치기해서 uvicorn이 1번 프로세스가 되게 한다.
CMD exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}
