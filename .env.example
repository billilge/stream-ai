# .env로 복사해서 사용.
#
# 인증은 API 키가 아니라 gcloud 로그인(ADC)으로 한다. 백엔드와 같은 GCP 프로젝트를 쓴다.
#   1. gcloud 설치: https://cloud.google.com/sdk/docs/install
#   2. gcloud auth application-default login
#   3. gcloud auth application-default set-quota-project my-project-kmualpha
#
# app.py는 이 값들을 직접 읽지 않는다. google-genai SDK가 환경변수를 보고 Vertex로 붙는다.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=my-project-kmualpha
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash-lite

# dev면 확인용 데모 페이지(GET /)가 열린다. 배포할 때는 prod
ENV=dev

# 백엔드와 같은 값을 넣는다(백엔드 쪽 이름은 STREAM_AI_INTERNAL_TOKEN).
# 비워 두면 헤더 검증을 건너뛴다. 개발에서 데모 페이지를 쓰려면 비워 둔다.
# ENV=prod 인데 비어 있으면 서버가 뜨지 않는다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=
