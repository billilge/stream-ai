# .env로 복사해서 사용.

# ─── 답변 모델 (서버가 쓴다) ───────────────────────────────
# 학교 AI 게이트웨이(ai.cs.kookmin.ac.kr)의 모델로 답한다. llm.py가 읽는다.
# 모델을 고른 근거는 eval/model-comparison.md(#61).
LLM_MODEL=gpt-oss-120b
# 게이트웨이에서 받은 API 키. 저장소에 올리지 않는다.
KMU_AI_API_KEY=
# 게이트웨이 주소. 바꿀 일이 없으면 비워 둔다(기본값이 들어간다).
# LLM_BASE_URL=https://ai.cs.kookmin.ac.kr/v1

# ─── 백엔드 연결 (재고 같은 실시간 조회) ──────────────────────
# 백엔드 주소. 도구가 학생 JWT(X-User-Token)로 백엔드 학생 API를 조회한다.
# 비워 두면 tools.py의 가짜 응답을 쓴다. 로컬 개발과 평가(eval.py)는 비워 둔다(학생 토큰이 없다).
# ENV=prod 인데 비어 있으면 서버가 뜨지 않는다.
BACKEND_BASE_URL=

# ─── 평가용 Gemini (eval.py만 쓴다, 서버는 쓰지 않는다) ─────────
# eval.py의 채점기와 예전 답변 경로가 Gemini를 쓴다. 서버를 띄우기만 할 거면 없어도 된다.
#
# 인증은 API 키가 아니라 gcloud 로그인(ADC)으로 한다. 백엔드와 같은 GCP 프로젝트를 쓴다.
#   1. gcloud 설치: https://cloud.google.com/sdk/docs/install
#   2. gcloud auth application-default login
#   3. gcloud auth application-default set-quota-project my-project-kmualpha
#
# app.py는 이 값들을 직접 읽지 않는다. google-genai SDK가 환경변수를 보고 Vertex로 붙는다.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=my-project-kmualpha
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash-lite

# dev면 확인용 데모 페이지(GET /)가 열린다. 배포할 때는 prod
ENV=dev

# 백엔드와 같은 값을 넣는다(백엔드 쪽 이름은 STREAM_AI_INTERNAL_TOKEN).
# 비워 두면 헤더 검증을 건너뛴다. 개발에서 데모 페이지를 쓰려면 비워 둔다.
# ENV=prod 인데 비어 있으면 서버가 뜨지 않는다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=
